@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Lộ trình";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(180deg, #f4f7f6 0%, #ffffff 100%);
        }

        .route-page {
            padding: 28px 0 46px;
        }

        .route-shell {
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .route-hero,
        .route-plan-card,
        .route-map-card,
        .route-summary-card,
        .route-stop-card {
            background: #fff;
            border-radius: 24px;
            border: 1px solid #e8efec;
            box-shadow: 0 14px 36px rgba(15, 25, 21, 0.07);
        }

        .route-hero {
            padding: 28px;
            display: flex;
            justify-content: space-between;
            gap: 20px;
            align-items: flex-end;
            flex-wrap: wrap;
        }

        .route-title {
            font-size: 42px;
            font-weight: 800;
            line-height: 1.1;
            color: #18221e;
            margin-bottom: 10px;
        }

        .route-subtitle {
            font-size: 17px;
            color: #64766f;
            margin-bottom: 0;
            max-width: 760px;
        }

        .route-tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border-radius: 999px;
            background: #eef8f2;
            color: #177b46;
            padding: 10px 16px;
            font-size: 14px;
            font-weight: 800;
            white-space: nowrap;
        }

        .route-main-grid {
            display: grid;
            grid-template-columns: minmax(360px, 430px) minmax(0, 1fr);
            gap: 24px;
            align-items: stretch;
        }

        .route-plan-card,
        .route-map-card {
            overflow: hidden;
            min-height: 720px;
            display: flex;
            flex-direction: column;
        }

        .route-plan-card {
            padding: 22px;
        }

        .route-card-title {
            font-size: 28px;
            font-weight: 800;
            color: #18231f;
            margin-bottom: 8px;
        }

        .route-card-subtitle {
            font-size: 15px;
            color: #697a73;
            margin-bottom: 20px;
        }

        .route-group {
            margin-bottom: 16px;
        }

        .route-label {
            display: block;
            font-size: 15px;
            font-weight: 700;
            color: #22312c;
            margin-bottom: 8px;
        }

        .route-plan-card .form-control,
        .route-plan-card .custom-select {
            min-height: 48px;
            border-radius: 14px;
            border: 1px solid #dce6e2;
            box-shadow: none !important;
            font-size: 15px;
        }

            .route-plan-card .form-control:focus,
            .route-plan-card .custom-select:focus {
                border-color: #1faa5f;
            }

        .route-place-wrap {
            position: relative;
        }

        .route-place-detail {
            margin-top: 8px;
            display: none;
            border-radius: 14px;
            border: 1px solid #dce6e2;
            background: #f8fbfa;
            padding: 10px 12px;
            font-size: 13px;
            color: #4e635b;
            line-height: 1.5;
        }

            .route-place-detail.is-visible {
                display: block;
            }

            .route-place-detail strong {
                color: #1c2a25;
            }

        .route-suggest-box {
            position: absolute;
            top: calc(100% + 8px);
            left: 0;
            right: 0;
            z-index: 40;
            display: none;
            max-height: 320px;
            overflow: auto;
            border-radius: 18px;
            border: 1px solid #dfe8e4;
            background: #ffffff;
            box-shadow: 0 18px 44px rgba(15, 25, 21, 0.12);
        }

            .route-suggest-box.is-open {
                display: block;
            }

        .route-suggest-item {
            width: 100%;
            border: 0;
            background: transparent;
            text-align: left;
            padding: 12px 14px;
            border-bottom: 1px solid #eef3f0;
            cursor: pointer;
        }

            .route-suggest-item:last-child {
                border-bottom: 0;
            }

            .route-suggest-item:hover,
            .route-suggest-item:focus {
                background: #f3faf6;
                outline: none;
            }

        .route-suggest-title {
            font-size: 14px;
            font-weight: 800;
            color: #1c2a25;
            margin-bottom: 4px;
        }

        .route-suggest-address {
            font-size: 12px;
            color: #667871;
            line-height: 1.5;
        }

        .route-suggest-empty {
            padding: 14px;
            font-size: 13px;
            color: #667871;
        }

        .route-grid-2 {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
        }

        .route-action-row {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
            margin-top: 8px;
        }

            .route-action-row .btn {
                min-height: 48px;
                border-radius: 14px;
                font-weight: 700;
                box-shadow: none !important;
            }

        .route-go-now-btn {
            width: 100%;
            min-height: 48px;
            border-radius: 14px;
            font-weight: 700;
            margin-top: 12px;
            display: none;
            box-shadow: none !important;
        }

            .route-go-now-btn.is-visible {
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

        .route-list-group-title {
            font-size: 18px;
            font-weight: 800;
            color: #18231f;
            margin: 4px 0 12px;
        }

        .route-note {
            margin-top: 16px;
            padding: 14px 16px;
            border-radius: 16px;
            border: 1px dashed #d1e2da;
            background: #f8fbfa;
            font-size: 14px;
            color: #5a6d66;
        }

        .route-map-topbar {
            padding: 20px 22px;
            border-bottom: 1px solid #eef3f0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            flex-wrap: wrap;
        }

            .route-map-topbar p {
                margin: 0;
                font-size: 14px;
                color: #687a73;
            }

        .route-map-chip {
            border-radius: 999px;
            background: #f4f8f6;
            color: #466359;
            padding: 8px 12px;
            font-size: 13px;
            font-weight: 700;
        }

        #routeMap {
            width: 100%;
            flex: 1 1 auto;
            min-height: 640px;
            background: #f6faf8;
        }

            #routeMap.route-map-failed {
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 24px;
                background: #fff5f5;
            }

        .route-map-message {
            max-width: 460px;
            text-align: center;
            font-size: 15px;
            line-height: 1.7;
            color: #b42318;
        }

        .route-summary-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 16px;
        }

        .route-summary-card {
            padding: 20px 22px;
        }

        .route-summary-label {
            font-size: 14px;
            color: #71827b;
            margin-bottom: 10px;
        }

        .route-summary-value {
            font-size: 32px;
            font-weight: 800;
            line-height: 1.05;
            color: #17231f;
        }

        .route-stop-card {
            padding: 22px;
        }

        .route-stop-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
            margin-bottom: 18px;
        }

        .route-stop-list {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .route-stop-item {
            border: 1px solid #e8efec;
            border-radius: 20px;
            background: linear-gradient(180deg, #ffffff 0%, #fafdfb 100%);
            padding: 18px;
        }

        .route-stop-index {
            width: 38px;
            height: 38px;
            border-radius: 999px;
            background: #177b46;
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            font-weight: 800;
            flex-shrink: 0;
        }

        .route-stop-row {
            display: flex;
            gap: 14px;
            align-items: flex-start;
        }

        .route-stop-title {
            font-size: 20px;
            font-weight: 800;
            color: #18231f;
            margin-bottom: 6px;
        }

        .route-stop-address {
            font-size: 14px;
            color: #667871;
            margin-bottom: 10px;
        }

        .route-stop-meta {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 12px;
        }

        .route-stop-pill {
            border-radius: 999px;
            background: #f4f8f6;
            color: #466359;
            padding: 7px 12px;
            font-size: 12px;
            font-weight: 700;
        }

        .route-stop-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

            .route-stop-actions .btn {
                min-height: 38px;
                border-radius: 999px;
                font-size: 12px;
                font-weight: 700;
                box-shadow: none !important;
                padding: 8px 14px;
            }

        .route-stop-selected-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 20px;
        }

        .route-selected-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border-radius: 999px;
            background: #eef8f2;
            color: #177b46;
            padding: 6px 10px;
            font-size: 12px;
            font-weight: 800;
        }

        .route-station-compact-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .route-station-compact-item {
            border: 1px solid #e8efec;
            border-radius: 18px;
            background: #fff;
            padding: 14px 16px;
        }

        .route-station-compact-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 14px;
            margin-bottom: 8px;
        }

        .route-station-main {
            min-width: 0;
            flex: 1;
        }

        .route-station-compact-title {
            font-size: 18px;
            font-weight: 800;
            color: #18231f;
            margin-bottom: 4px;
        }

        .route-station-compact-address {
            font-size: 14px;
            color: #667871;
            margin-bottom: 8px;
        }

        .route-station-compact-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 10px;
        }

        .route-station-compact-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

            .route-station-compact-actions .btn {
                min-height: 36px;
                border-radius: 999px;
                font-size: 12px;
                font-weight: 700;
                padding: 7px 14px;
                box-shadow: none !important;
            }

        .route-stop-toolbar {
            margin-bottom: 18px;
            padding: 16px 18px;
            border: 1px solid #e6efeb;
            border-radius: 18px;
            background: linear-gradient(180deg, #fbfdfc 0%, #f7faf9 100%);
        }

        .route-toolbar-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.6fr) repeat(4, minmax(0, 1fr));
            gap: 12px;
            align-items: end;
        }

        .route-toolbar-field {
            min-width: 0;
        }

        .route-toolbar-label {
            display: block;
            font-size: 13px;
            font-weight: 700;
            color: #51655d;
            margin-bottom: 6px;
        }

        .route-stop-toolbar .form-control,
        .route-stop-toolbar .custom-select,
        .route-stop-toolbar .btn {
            min-height: 44px;
            border-radius: 12px;
            box-shadow: none !important;
        }

        .route-stop-toolbar .form-control,
        .route-stop-toolbar .custom-select {
            border: 1px solid #dbe7e2;
        }

        .route-toolbar-actions {
            display: flex;
            justify-content: flex-end;
            align-items: end;
            gap: 10px;
            margin-top: 12px;
            flex-wrap: wrap;
        }

        .route-stop-list-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 14px;
        }

        .route-stop-list-meta-text {
            font-size: 14px;
            color: #63766e;
        }

        .route-count-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 12px;
            border-radius: 999px;
            background: #eef7f2;
            color: #177b46;
            font-size: 12px;
            font-weight: 800;
        }

        .route-section-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 12px;
        }

        .route-section-subtitle {
            font-size: 13px;
            color: #72847d;
        }

        .route-stop-list,
        .route-station-compact-list,
        .route-stop-selected-list {
            gap: 12px;
        }

        .route-stop-item,
        .route-station-compact-item {
            box-shadow: 0 8px 18px rgba(15, 25, 21, 0.04);
        }

        .route-pagination {
            margin-top: 18px;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

            .route-pagination .btn {
                min-width: 40px;
                height: 40px;
                border-radius: 12px;
                font-weight: 700;
                box-shadow: none !important;
            }

        .route-pagination-status {
            font-size: 13px;
            color: #6b7d76;
            margin: 0 4px;
        }

        .route-empty,
        .route-error,
        .route-loading {
            border-radius: 18px;
            padding: 18px;
            text-align: center;
            font-size: 15px;
        }

        .route-empty,
        .route-loading {
            background: #f7faf9;
            color: #556861;
            border: 1px dashed #d3e2db;
        }

        .route-error {
            background: #fff5f5;
            color: #b42318;
            border: 1px dashed #f0c2c2;
        }

        .route-main-grid > *,
        .route-summary-grid > * {
            min-width: 0;
        }

        @@media (max-width: 1199.98px) {
            .route-toolbar-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .route-main-grid,
            .route-summary-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 991.98px) {
            .route-main-grid,
            .route-summary-grid,
            .route-toolbar-grid {
                grid-template-columns: 1fr;
            }

            .route-toolbar-actions {
                justify-content: stretch;
            }

                .route-toolbar-actions .btn {
                    width: 100%;
                }

            #routeMap {
                height: 480px;
            }
        }

        @@media (max-width: 767.98px) {
            .route-page {
                padding-top: 20px;
            }

            .route-title {
                font-size: 34px;
            }

            .route-grid-2,
            .route-action-row {
                grid-template-columns: 1fr;
            }

            .route-stop-card,
            .route-plan-card,
            .route-summary-card {
                padding-left: 16px;
                padding-right: 16px;
            }

            .route-stop-actions,
            .route-station-compact-actions {
                flex-direction: column;
            }

                .route-stop-actions .btn,
                .route-station-compact-actions .btn {
                    width: 100%;
                }
        }
    </style>
}

<div class="sub_banner_outer position-relative user-header-shell">
    @await Html.PartialAsync("_UserHeader")
</div>

<section class="route-page">
    <div class="container">
        <div class="route-shell">


            <div class="route-main-grid">
                <div class="route-plan-card">
                    <h2 class="route-card-title">Thông tin chuyến đi</h2>
                    @* <p class="route-card-subtitle">Nhập điểm đi, điểm đến và ngưỡng pin an toàn để hệ thống đề xuất trạm dừng.</p> *@

                    <div class="route-group">
                        <label class="route-label">Điểm đi</label>
                        <div class="route-place-wrap">
                            <input id="startPoint" type="text" class="form-control" placeholder="Ví dụ: Bắc Ninh" autocomplete="off" />
                            <div id="startSuggestBox" class="route-suggest-box"></div>
                        </div>
                        <div id="startPlaceDetail" class="route-place-detail"></div>
                    </div>

                    <div class="route-group">
                        <label class="route-label">Điểm đến</label>
                        <div class="route-place-wrap">
                            <input id="endPoint" type="text" class="form-control" placeholder="Ví dụ: Nghệ An" autocomplete="off" />
                            <div id="endSuggestBox" class="route-suggest-box"></div>
                        </div>
                        <div id="endPlaceDetail" class="route-place-detail"></div>
                    </div>

                    <div class="route-grid-2">
                        <div class="route-group">
                            <label class="route-label">Tầm hoạt động tối đa</label>
                            <input id="vehicleRangeKm" type="number" min="100" max="1000" step="10" value="400" class="form-control" />
                        </div>
                        <div class="route-group">
                            <label class="route-label">Pin hiện tại (%)</label>
                            <input id="startBattery" type="number" min="10" max="100" step="5" value="80" class="form-control" />
                        </div>
                    </div>

                    <div class="route-grid-2">
                        <div class="route-group">
                            <label class="route-label">Pin dự phòng tối thiểu</label>
                            <input id="reserveBattery" type="number" min="5" max="40" step="5" value="20" class="form-control" />
                        </div>
                        <div class="route-group">
                            <label class="route-label">Lệch tối đa khỏi tuyến</label>
                            <select id="maxDetourKm" class="custom-select">
                                <option value="5">5 km</option>
                                <option value="10" selected>10 km</option>
                                <option value="15">15 km</option>
                                <option value="20">20 km</option>
                                <option value="30">30 km</option>
                            </select>
                        </div>
                    </div>

                    <div class="route-action-row">
                        <button type="button" id="btnPlanRoute" class="btn btn-success">
                            <i class="fa-solid fa-bolt mr-2"></i>Lập kế hoạch
                        </button>
                        <button type="button" id="btnResetRoute" class="btn btn-outline-secondary">
                            <i class="fa-solid fa-rotate-left mr-2"></i>Làm mới
                        </button>
                    </div>

                    <button type="button" id="btnGoNow" class="btn btn-dark route-go-now-btn">
                        <i class="fa-solid fa-route mr-2"></i>Đi ngay bằng Google Maps
                    </button>

                    <div class="route-note" id="routeNote">
                        Gợi ý lập kế hoạch: hệ thống ưu tiên trạm <strong>Hoạt động</strong>, gần tuyến và đủ để xe luôn giữ lại mức pin dự phòng bạn đã chọn.
                    </div>
                </div>

                <div class="route-map-card">
                    <div class="route-map-topbar">
                        <div>
                            <h2 class="route-card-title mb-1">Bản đồ hành trình</h2>
                            <p id="routeMapHint">Chưa có dữ liệu hành trình.</p>
                        </div>
                        <div class="route-map-chip" id="routeMapChip">0 điểm dừng</div>
                    </div>
                    <div id="routeMap"></div>
                </div>
            </div>

            <div class="route-summary-grid">
                <div class="route-summary-card">
                    <div class="route-summary-label">Quãng đường ước tính</div>
                    <div id="summaryTotalDistance" class="route-summary-value">0 km</div>
                </div>
                <div class="route-summary-card">
                    <div class="route-summary-label">Đi được trước trạm đầu</div>
                    <div id="summaryFirstLeg" class="route-summary-value">0 km</div>
                </div>
                <div class="route-summary-card">
                    <div class="route-summary-label">Số trạm gợi ý</div>
                    <div id="summaryStopCount" class="route-summary-value">0</div>
                </div>
                <div class="route-summary-card">
                    <div class="route-summary-label">Trạm hợp tuyến</div>
                    <div id="summaryCorridorCount" class="route-summary-value">0</div>
                </div>
            </div>

            <div class="route-stop-card">
                <div class="route-stop-header">
                    <div>
                        <h2 class="route-card-title mb-1">Danh sách trạm dừng đề xuất</h2>
                        @* <p class="route-card-subtitle mb-0">Danh sách này xếp theo tiến độ trên hành trình, không phải chỉ theo khoảng cách thẳng.</p> *@
                    </div>
                    <div class="route-map-chip" id="routeResultState">Chưa lập kế hoạch</div>
                </div>

                <div class="route-stop-toolbar">
                    <div class="route-toolbar-grid">
                        <div class="route-toolbar-field">
                            <label class="route-toolbar-label" for="stationFilterKeyword">Tìm theo tên hoặc địa chỉ</label>
                            <input id="stationFilterKeyword" type="text" class="form-control" placeholder="Ví dụ: Long Biên, Metro, Vincom..." />
                        </div>
                        <div class="route-toolbar-field">
                            <label class="route-toolbar-label" for="stationFilterDetour">Lọc theo độ lệch</label>
                            <select id="stationFilterDetour" class="custom-select">
                                <option value="all">Tất cả</option>
                                <option value="5">≤ 5 km</option>
                                <option value="10">≤ 10 km</option>
                                <option value="15">≤ 15 km</option>
                                <option value="20">≤ 20 km</option>
                            </select>
                        </div>
                        <div class="route-toolbar-field">
                            <label class="route-toolbar-label" for="stationFilterSort">Sắp xếp</label>
                            <select id="stationFilterSort" class="custom-select">
                                <option value="progress">Ưu tiên theo hành trình</option>
                                <option value="detour">Lệch tuyến thấp nhất</option>
                                <option value="rating">Đánh giá cao nhất</option>
                                <option value="ports">Nhiều trụ hoạt động nhất</option>
                                <option value="name">Tên A-Z</option>
                            </select>
                        </div>
                        <div class="route-toolbar-field">
                            <label class="route-toolbar-label" for="stationPageSize">Hiển thị mỗi trang</label>
                            <select id="stationPageSize" class="custom-select">
                                <option value="4">4 trạm</option>
                                <option value="6" selected>6 trạm</option>
                                <option value="8">8 trạm</option>
                                <option value="10">10 trạm</option>
                            </select>
                        </div>
                        <div class="route-toolbar-field">
                            <label class="route-toolbar-label">Trạng thái lọc</label>
                            <div id="routeStopToolbarState" class="route-count-badge">Chưa có dữ liệu</div>
                        </div>
                    </div>
                    <div class="route-toolbar-actions">
                        <button type="button" id="btnClearStationFilter" class="btn btn-outline-secondary">
                            <i class="fa-solid fa-filter-circle-xmark mr-2"></i>Xóa lọc
                        </button>
                    </div>
                </div>

                <div id="routeStopListMeta" class="route-stop-list-meta">
                    <div class="route-stop-list-meta-text">Nhập thông tin chuyến đi để bắt đầu lập kế hoạch.</div>
                </div>

                <div id="routeStopList" class="route-stop-list">
                    <div class="route-empty">Nhập thông tin chuyến đi để bắt đầu lập kế hoạch.</div>
                </div>

                <div id="routeStopPagination" class="route-pagination"></div>
            </div>
        </div>
    </div>
</section>


@section Scripts {
    <script>
        const MAP4D_API_KEY = '@(Configuration["Map4D:ApiKey"] ?? "")';
        const DEFAULT_MAP_CENTER = { lat: 16.5, lng: 107.5 };

        let routeMap = null;
        let mapReadyPromise = null;
        let startMarker = null;
        let endMarker = null;
        let routeLine = null;
        let corridorMarkers = [];
        let stopMarkers = [];
        let focusMarker = null;
        let latestTripContext = null;
        // Why changed: keep list filters and pagination stable after each route update.
        const routeListState = {
            keyword: '',
            detourLimit: 'all',
            sortBy: 'progress',
            page: 1,
            pageSize: 6
        };

        const placePickerState = {
            start: { selected: null, debounceId: null },
            end: { selected: null, debounceId: null }
        };

        document.addEventListener('DOMContentLoaded', async function () {
            bindRouteEvents();

            try {
                await ensureRouteMapReady();
            } catch (error) {
                console.error(error);
                showMapLoadError(error.message || 'Không tải được bản đồ Map4D.');
            }
        });

        function bindRouteEvents() {
            document.getElementById('btnPlanRoute')?.addEventListener('click', planTrip);
            document.getElementById('btnResetRoute')?.addEventListener('click', resetRoutePage);
            document.getElementById('btnGoNow')?.addEventListener('click', openPlannedTripInGoogleMaps);

            setupPlaceAutosuggest('start');
            setupPlaceAutosuggest('end');

            document.addEventListener('click', function (event) {
                if (!(event.target instanceof Element)) {
                    return;
                }

                if (!event.target.closest('.route-place-wrap')) {
                    closeSuggestBox('start');
                    closeSuggestBox('end');
                }
            });

            // Why changed: allow enterprise-style filtering and pagination for the station list.
            document.getElementById('stationFilterKeyword')?.addEventListener('input', function (event) {
                routeListState.keyword = String(event.target.value || '').trim();
                routeListState.page = 1;
                rerenderRouteStopsFromContext();
            });

            document.getElementById('stationFilterDetour')?.addEventListener('change', function (event) {
                routeListState.detourLimit = String(event.target.value || 'all');
                routeListState.page = 1;
                rerenderRouteStopsFromContext();
            });

            document.getElementById('stationFilterSort')?.addEventListener('change', function (event) {
                routeListState.sortBy = String(event.target.value || 'progress');
                routeListState.page = 1;
                rerenderRouteStopsFromContext();
            });

            document.getElementById('stationPageSize')?.addEventListener('change', function (event) {
                routeListState.pageSize = Math.max(1, Number(event.target.value || 6));
                routeListState.page = 1;
                rerenderRouteStopsFromContext();
            });

            document.getElementById('btnClearStationFilter')?.addEventListener('click', resetRouteListFilters);
        }

        function ensureRouteMapReady() {
            if (routeMap) {
                return Promise.resolve(routeMap);
            }

            if (mapReadyPromise) {
                return mapReadyPromise;
            }

            mapReadyPromise = new Promise((resolve, reject) => {
                if (!MAP4D_API_KEY || MAP4D_API_KEY.includes('DAN_KEY_MAP4D_CUA_BAN_VAO_DAY')) {
                    reject(new Error('Bạn chưa dán API key Map4D vào Route.cshtml.'));
                    return;
                }

                if (window.map4d) {
                    try {
                        initRouteMap();
                        resolve(routeMap);
                    } catch (error) {
                        reject(error);
                    }
                    return;
                }

                // Why changed: register the callback first so the SDK can initialize safely.
                window.__map4dRouteSdkLoaded = function () {
                    try {
                        initRouteMap();
                        resolve(routeMap);
                    } catch (error) {
                        reject(error);
                    }
                };

                const existingScript = document.getElementById('map4d-sdk-script');
                if (existingScript) {
                    existingScript.addEventListener('error', function () {
                        reject(new Error('Không tải được file SDK từ Map4D.'));
                    }, { once: true });
                    return;
                }

                const sdkScript = document.createElement('script');
                sdkScript.id = 'map4d-sdk-script';
                sdkScript.defer = true;
                sdkScript.src = `https://api.map4d.vn/sdk/map/js?version=3.0&key=${encodeURIComponent(MAP4D_API_KEY)}&callback=__map4dRouteSdkLoaded`;
                sdkScript.onerror = function () {
                    reject(new Error('Không tải được file SDK từ Map4D. Hãy kiểm tra lại key và kết nối mạng.'));
                };

                document.head.appendChild(sdkScript);
            });

            return mapReadyPromise;
        }

        function initRouteMap() {
            if (routeMap) {
                return;
            }

            const mapElement = document.getElementById('routeMap');
            mapElement.classList.remove('route-map-failed');
            mapElement.innerHTML = '';

            routeMap = new map4d.Map(mapElement, {
                center: DEFAULT_MAP_CENTER,
                zoom: 6,
                controls: true
            });
        }


        function setupPlaceAutosuggest(prefix) {
            const inputId = prefix === 'start' ? 'startPoint' : 'endPoint';
            const input = document.getElementById(inputId);

            if (!input) {
                return;
            }

            input.addEventListener('input', function () {
                placePickerState[prefix].selected = null;
                renderSelectedPlace(prefix, null);

                const keyword = input.value.trim();
                window.clearTimeout(placePickerState[prefix].debounceId);

                if (keyword.length < 2) {
                    renderSuggestItems(prefix, []);
                    return;
                }

                placePickerState[prefix].debounceId = window.setTimeout(async function () {
                    try {
                        const items = await fetchPlaceSuggestions(keyword);
                        renderSuggestItems(prefix, items);
                    } catch (error) {
                        console.error(error);
                        renderSuggestItems(prefix, [], 'Không lấy được gợi ý địa điểm.');
                    }
                }, 280);
            });

            input.addEventListener('focus', function () {
                const keyword = input.value.trim();
                if (keyword.length >= 2) {
                    window.clearTimeout(placePickerState[prefix].debounceId);
                    placePickerState[prefix].debounceId = window.setTimeout(async function () {
                        try {
                            const items = await fetchPlaceSuggestions(keyword);
                            renderSuggestItems(prefix, items);
                        } catch (error) {
                            console.error(error);
                        }
                    }, 120);
                }
            });

            input.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') {
                    closeSuggestBox(prefix);
                }
            });
        }

        async function fetchPlaceSuggestions(keyword) {
            const response = await fetch(`/User/Home/PlaceSuggest?keyword=${encodeURIComponent(keyword)}`);
            if (!response.ok) {
                throw new Error('Không tải được gợi ý địa điểm.');
            }

            const data = await response.json();
            return Array.isArray(data) ? data : [];
        }

        async function fetchResolvedPlace(keyword, placeId) {
            const query = new URLSearchParams();
            query.set('keyword', keyword || '');
            if (placeId) {
                query.set('placeId', placeId);
            }

            const response = await fetch(`/User/Home/PlaceResolve?${query.toString()}`);
            if (!response.ok) {
                return null;
            }

            const data = await response.json();
            return data && data.success && data.item ? data.item : null;
        }

        function renderSuggestItems(prefix, items, fallbackMessage) {
            const box = document.getElementById(`${prefix}SuggestBox`);
            if (!box) {
                return;
            }

            const safeItems = Array.isArray(items) ? items.slice(0, 8) : [];

            if (safeItems.length === 0) {
                if ((document.getElementById(prefix === 'start' ? 'startPoint' : 'endPoint')?.value || '').trim().length < 2) {
                    box.innerHTML = '';
                    box.classList.remove('is-open');
                    return;
                }

                box.innerHTML = `<div class="route-suggest-empty">${escapeHtml(fallbackMessage || 'Không tìm thấy địa điểm phù hợp.')}</div>`;
                box.classList.add('is-open');
                return;
            }

            box.innerHTML = safeItems.map((item, index) => `
                <button type="button"
                        class="route-suggest-item"
                        onclick="selectSuggestedPlace('${prefix}', ${index})">
                    <div class="route-suggest-title">${escapeHtml(item.displayName || item.name || 'Địa điểm')}</div>
                    <div class="route-suggest-address">${escapeHtml(item.address || item.displayName || '')}</div>
                </button>
            `).join('');

            placePickerState[prefix].items = safeItems;
            box.classList.add('is-open');
        }

        function closeSuggestBox(prefix) {
            const box = document.getElementById(`${prefix}SuggestBox`);
            if (!box) {
                return;
            }

            box.classList.remove('is-open');
        }

        function selectSuggestedPlace(prefix, index) {
            const items = Array.isArray(placePickerState[prefix].items) ? placePickerState[prefix].items : [];
            const item = items[index];
            if (!item) {
                return;
            }

            const input = document.getElementById(prefix === 'start' ? 'startPoint' : 'endPoint');
            if (input) {
                input.value = item.displayName || item.name || '';
            }

            placePickerState[prefix].selected = item;
            renderSelectedPlace(prefix, item);
            closeSuggestBox(prefix);
        }

        function renderSelectedPlace(prefix, item) {
            const detailElement = document.getElementById(`${prefix}PlaceDetail`);
            if (!detailElement) {
                return;
            }

            if (!item) {
                detailElement.innerHTML = '';
                detailElement.classList.remove('is-visible');
                return;
            }

            const title = item.name || item.displayName || 'Địa điểm đã chọn';
            const address = item.address || item.displayName || '';
            detailElement.innerHTML = `
                <strong>Đã chọn:</strong> ${escapeHtml(title)}
                ${address ? `<br /><span>${escapeHtml(address)}</span>` : ''}
            `;
            detailElement.classList.add('is-visible');
        }

        async function resolvePlaceInput(prefix) {
            const input = document.getElementById(prefix === 'start' ? 'startPoint' : 'endPoint');
            const rawText = String(input?.value || '').trim();

            if (!rawText) {
                return null;
            }

            const selected = placePickerState[prefix].selected;
            if (selected && Number.isFinite(Number(selected.lat)) && Number.isFinite(Number(selected.lng))) {
                return {
                    lat: Number(selected.lat),
                    lng: Number(selected.lng),
                    displayName: selected.displayName || selected.name || rawText,
                    address: selected.address || selected.displayName || rawText
                };
            }

            const resolved = await fetchResolvedPlace(rawText, selected?.id || '');
            if (!resolved) {
                return null;
            }

            const normalized = {
                lat: Number(resolved.lat),
                lng: Number(resolved.lng),
                displayName: resolved.displayName || resolved.name || rawText,
                address: resolved.address || resolved.displayName || rawText
            };

            placePickerState[prefix].selected = resolved;
            renderSelectedPlace(prefix, resolved);

            if (input) {
                input.value = normalized.displayName;
            }

            return normalized;
        }

        function resetPlacePicker(prefix) {
            placePickerState[prefix].selected = null;
            placePickerState[prefix].items = [];
            window.clearTimeout(placePickerState[prefix].debounceId);
            closeSuggestBox(prefix);
            renderSelectedPlace(prefix, null);
        }

        async function planTrip() {
            const startText = document.getElementById('startPoint').value.trim();
            const endText = document.getElementById('endPoint').value.trim();
            const vehicleRangeKm = Number(document.getElementById('vehicleRangeKm').value || 0);
            const startBattery = Number(document.getElementById('startBattery').value || 0);
            const reserveBattery = Number(document.getElementById('reserveBattery').value || 0);
            const maxDetourKm = Number(document.getElementById('maxDetourKm').value || 10);

            if (!startText || !endText) {
                alert('Vui lòng nhập đầy đủ điểm đi và điểm đến.');
                return;
            }

            if (vehicleRangeKm < 100) {
                alert('Tầm hoạt động tối đa phải từ 100 km trở lên.');
                return;
            }

            if (startBattery <= reserveBattery) {
                alert('Pin hiện tại phải lớn hơn pin dự phòng tối thiểu.');
                return;
            }

            try {
                await ensureRouteMapReady();
                setRouteLoadingState();

                const [start, end] = await Promise.all([
                    resolvePlaceInput('start'),
                    resolvePlaceInput('end')
                ]);

                if (!start || !end) {
                    throw new Error('Không tìm thấy một trong hai địa điểm. Hãy chọn lại từ gợi ý chi tiết.');
                }

                // Why changed: use a real road path so the map shows an actual trip, not only a straight line.
                const routeData = await getDrivingRoute(start, end);
                const routePath = routeData.path.length >= 2
                    ? routeData.path
                    : [
                        { lat: start.lat, lng: start.lng },
                        { lat: end.lat, lng: end.lng }
                    ];

                const totalDistanceKm = routeData.distanceKm > 0
                    ? routeData.distanceKm
                    : calculateDistanceKm(start.lat, start.lng, end.lat, end.lng);

                const firstLegKm = vehicleRangeKm * ((startBattery - reserveBattery) / 100);
                const fullSafeLegKm = vehicleRangeKm * ((100 - reserveBattery) / 100);

                const response = await fetch('/User/api/stations');
                if (!response.ok) {
                    throw new Error('Không tải được danh sách trạm.');
                }

                const allStations = await response.json();
                const activeStations = (allStations || []).filter(station =>
                    station &&
                    station.status === 'Hoạt động' &&
                    Number.isFinite(Number(station.latitude)) &&
                    Number.isFinite(Number(station.longitude))
                );

                // Why changed: measure stations against the actual route corridor, not the straight segment.
                const corridorStations = activeStations
                    .map(station => {
                        const metrics = analyzeStationAgainstRoute(
                            Number(station.latitude),
                            Number(station.longitude),
                            routePath
                        );

                        return {
                            ...station,
                            routeDistanceKm: metrics.routeDistanceKm,
                            detourKm: metrics.routeDistanceKm,
                            progressKm: metrics.progressKm,
                            progressRatio: totalDistanceKm <= 0 ? 0 : metrics.progressKm / totalDistanceKm,
                            distanceToDestinationKm: calculateDistanceKm(
                                Number(station.latitude),
                                Number(station.longitude),
                                end.lat,
                                end.lng
                            )
                        };
                    })
                    .filter(station => station.routeDistanceKm <= maxDetourKm)
                    .sort((a, b) => a.progressKm - b.progressKm);

                const plan = buildRoutePlan(corridorStations, totalDistanceKm, firstLegKm, fullSafeLegKm);

                drawRoute(start, end, routePath, corridorStations, plan.stops);
                renderRouteSummary(totalDistanceKm, firstLegKm, corridorStations.length, plan.stops.length);
                renderRouteStops(plan, totalDistanceKm, maxDetourKm, corridorStations);

                document.getElementById('routeMapHint').textContent =
                    `Đã lập kế hoạch từ ${escapeHtml(start.displayName)} đến ${escapeHtml(end.displayName)}.`;
                document.getElementById('routeMapChip').textContent =
                    `${plan.stops.length} điểm dừng / ${corridorStations.length} trạm gần tuyến`;
                document.getElementById('routeResultState').textContent =
                    plan.isReachable ? 'Có phương án' : 'Cần điều chỉnh';
                document.getElementById('routeNote').innerHTML = plan.isReachable
                    ? `Đường đi đã hiển thị trên bản đồ. Hệ thống đang tính theo pin hiện tại <strong>${startBattery}%</strong>, pin dự phòng <strong>${reserveBattery}%</strong> và độ lệch tối đa <strong>${maxDetourKm} km</strong>.`
                    : `Đường đi đã hiển thị trên bản đồ nhưng không tìm được chuỗi trạm đủ an toàn với pin dự phòng <strong>${reserveBattery}%</strong>. Hãy tăng độ lệch tuyến hoặc kiểm tra lại tầm hoạt động xe.`;

                // Why changed: keep the whole planning context so users can add or remove stops later.
                latestTripContext = {
                    start,
                    end,
                    routePath,
                    corridorStations,
                    totalDistanceKm,
                    firstLegKm,
                    maxDetourKm,
                    isReachable: plan.isReachable,
                    blockingDistanceKm: plan.blockingDistanceKm,
                    selectedStops: sortStationsByProgress(plan.stops),
                    stops: sortStationsByProgress(plan.stops)
                };
                updateRouteNoteAfterSelection();
                toggleGoNowButton(true);
            } catch (error) {
                console.error(error);
                latestTripContext = null;
                toggleGoNowButton(false);
                setRouteErrorState(error.message || 'Có lỗi xảy ra khi lập kế hoạch.');
            }
        }

        function buildRoutePlan(corridorStations, totalDistanceKm, firstLegKm, fullSafeLegKm) {
            const stops = [];
            let currentProgressKm = 0;
            let reachableKm = Math.max(firstLegKm, 0);
            const visitedIds = new Set();

            while (currentProgressKm + reachableKm < totalDistanceKm) {
                const nextStop = corridorStations
                    .filter(station => !visitedIds.has(station.id))
                    .filter(station => station.progressKm > currentProgressKm + 3)
                    .filter(station => station.progressKm <= currentProgressKm + reachableKm)
                    .sort((a, b) => {
                        if (b.progressKm !== a.progressKm) {
                            return b.progressKm - a.progressKm;
                        }

                        if (Number(b.activePoleCount || b.availablePoleCount || 0) !== Number(a.activePoleCount || a.availablePoleCount || 0)) {
                            return Number(b.activePoleCount || b.availablePoleCount || 0) - Number(a.activePoleCount || a.availablePoleCount || 0);
                        }

                        return a.routeDistanceKm - b.routeDistanceKm;
                    })[0];

                if (!nextStop) {
                    return {
                        isReachable: false,
                        stops,
                        blockingDistanceKm: currentProgressKm + reachableKm
                    };
                }

                stops.push(nextStop);
                visitedIds.add(nextStop.id);
                currentProgressKm = nextStop.progressKm;
                reachableKm = Math.max(fullSafeLegKm, 0);
            }

            return {
                isReachable: true,
                stops,
                blockingDistanceKm: totalDistanceKm
            };
        }

        function renderRouteSummary(totalDistanceKm, firstLegKm, corridorCount, stopCount) {
            document.getElementById('summaryTotalDistance').textContent = `${Math.max(totalDistanceKm, 0).toFixed(0)} km`;
            document.getElementById('summaryFirstLeg').textContent = `${Math.max(firstLegKm, 0).toFixed(0)} km`;
            document.getElementById('summaryCorridorCount').textContent = corridorCount;
            document.getElementById('summaryStopCount').textContent = stopCount;
        }

        function resetRouteListFilters() {
            routeListState.keyword = '';
            routeListState.detourLimit = 'all';
            routeListState.sortBy = 'progress';
            routeListState.page = 1;
            routeListState.pageSize = 6;

            const keywordInput = document.getElementById('stationFilterKeyword');
            const detourSelect = document.getElementById('stationFilterDetour');
            const sortSelect = document.getElementById('stationFilterSort');
            const pageSizeSelect = document.getElementById('stationPageSize');

            if (keywordInput) keywordInput.value = '';
            if (detourSelect) detourSelect.value = 'all';
            if (sortSelect) sortSelect.value = 'progress';
            if (pageSizeSelect) pageSizeSelect.value = '6';

            rerenderRouteStopsFromContext();
        }

        function rerenderRouteStopsFromContext() {
            if (!latestTripContext) {
                updateRouteStopToolbarState(0, 0, false);
                updateRouteStopMeta('Nhập thông tin chuyến đi để bắt đầu lập kế hoạch.');
                document.getElementById('routeStopList').innerHTML = '<div class="route-empty">Nhập thông tin chuyến đi để bắt đầu lập kế hoạch.</div>';
                document.getElementById('routeStopPagination').innerHTML = '';
                return;
            }

            renderRouteStops(
                {
                    isReachable: latestTripContext.isReachable,
                    stops: latestTripContext.selectedStops,
                    blockingDistanceKm: latestTripContext.blockingDistanceKm
                },
                latestTripContext.totalDistanceKm,
                latestTripContext.maxDetourKm,
                latestTripContext.corridorStations
            );
        }

        function updateRouteStopToolbarState(filteredCount, totalCount, isReady) {
            const element = document.getElementById('routeStopToolbarState');
            if (!element) {
                return;
            }

            element.textContent = !isReady
                ? 'Chưa có dữ liệu'
                : `${filteredCount}/${totalCount} trạm phù hợp`;
        }

        function updateRouteStopMeta(message) {
            const meta = document.getElementById('routeStopListMeta');
            if (!meta) {
                return;
            }

            meta.innerHTML = `<div class="route-stop-list-meta-text">${message}</div>`;
        }

        function getFilteredNearbyStations(stations) {
            const keyword = String(routeListState.keyword || '').trim().toLowerCase();
            const detourLimit = routeListState.detourLimit;
            const sortBy = routeListState.sortBy;

            let result = [...(Array.isArray(stations) ? stations : [])];

            if (keyword) {
                result = result.filter(station => {
                    const haystack = `${station?.name || ''} ${station?.address || ''}`.toLowerCase();
                    return haystack.includes(keyword);
                });
            }

            if (detourLimit !== 'all') {
                const maxDetour = Number(detourLimit);
                result = result.filter(station => Number(station?.routeDistanceKm || station?.detourKm || 0) <= maxDetour);
            }

            result.sort((a, b) => {
                if (sortBy === 'detour') {
                    return Number(a?.routeDistanceKm || a?.detourKm || 0) - Number(b?.routeDistanceKm || b?.detourKm || 0);
                }

                if (sortBy === 'rating') {
                    return Number(b?.averageRating || 0) - Number(a?.averageRating || 0);
                }

                if (sortBy === 'ports') {
                    return Number(b?.activePoleCount || b?.availablePoleCount || 0) - Number(a?.activePoleCount || a?.availablePoleCount || 0);
                }

                if (sortBy === 'name') {
                    return String(a?.name || '').localeCompare(String(b?.name || ''), 'vi');
                }

                return Number(a?.progressKm || 0) - Number(b?.progressKm || 0);
            });

            return result;
        }

        function buildPaginationHtml(page, totalPages) {
            if (totalPages <= 1) {
                return '';
            }

            const buttons = [];
            buttons.push(`
                <button type="button" class="btn btn-outline-secondary" onclick="goToRoutePage(${Math.max(1, page - 1)})" ${page <= 1 ? 'disabled' : ''}>
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
            `);

            const startPage = Math.max(1, page - 1);
            const endPage = Math.min(totalPages, startPage + 2);
            const realStart = Math.max(1, endPage - 2);

            for (let current = realStart; current <= endPage; current++) {
                buttons.push(`
                    <button type="button" class="btn ${current === page ? 'btn-success' : 'btn-outline-secondary'}" onclick="goToRoutePage(${current})">${current}</button>
                `);
            }

            buttons.push(`<span class="route-pagination-status">Trang ${page}/${totalPages}</span>`);
            buttons.push(`
                <button type="button" class="btn btn-outline-secondary" onclick="goToRoutePage(${Math.min(totalPages, page + 1)})" ${page >= totalPages ? 'disabled' : ''}>
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
            `);

            return buttons.join('');
        }

        function goToRoutePage(page) {
            routeListState.page = Math.max(1, Number(page || 1));
            rerenderRouteStopsFromContext();
        }

        function normalizeStationId(id) {
            return String(id ?? '');
        }

        function sortStationsByProgress(stations) {
            return [...(Array.isArray(stations) ? stations : [])]
                .sort((a, b) => Number(a?.progressKm || 0) - Number(b?.progressKm || 0));
        }

        function updateRouteNoteAfterSelection() {
            if (!latestTripContext) {
                return;
            }

            const stopCount = Array.isArray(latestTripContext.selectedStops)
                ? latestTripContext.selectedStops.length
                : 0;

            document.getElementById('routeNote').innerHTML =
                `Đường đi đã hiển thị trên bản đồ. Bạn có thể <strong>thêm trạm vào lộ trình</strong> từ danh sách bên dưới. Nút <strong>Đi ngay bằng Google Maps</strong> sẽ mở đúng các điểm hiện có trong lộ trình, hiện tại là <strong>${stopCount} điểm dừng</strong>.`;
        }

        function syncRouteFromCurrentSelection(focusStationId) {
            if (!latestTripContext) {
                return;
            }

            latestTripContext.selectedStops = sortStationsByProgress(latestTripContext.selectedStops);
            latestTripContext.stops = [...latestTripContext.selectedStops];

            drawRoute(
                latestTripContext.start,
                latestTripContext.end,
                latestTripContext.routePath,
                latestTripContext.corridorStations,
                latestTripContext.selectedStops
            );

            renderRouteSummary(
                latestTripContext.totalDistanceKm,
                latestTripContext.firstLegKm,
                latestTripContext.corridorStations.length,
                latestTripContext.selectedStops.length
            );

            renderRouteStops(
                {
                    isReachable: latestTripContext.isReachable,
                    stops: latestTripContext.selectedStops,
                    blockingDistanceKm: latestTripContext.blockingDistanceKm
                },
                latestTripContext.totalDistanceKm,
                latestTripContext.maxDetourKm,
                latestTripContext.corridorStations
            );

            document.getElementById('routeMapChip').textContent =
                `${latestTripContext.selectedStops.length} điểm dừng / ${latestTripContext.corridorStations.length} trạm gần tuyến`;
            document.getElementById('routeResultState').textContent =
                latestTripContext.selectedStops.length > 0 ? 'Đã cập nhật lộ trình' : 'Chưa thêm điểm dừng';

            updateRouteNoteAfterSelection();
            toggleGoNowButton(true);

            if (focusStationId) {
                const station = latestTripContext.corridorStations.find(item =>
                    normalizeStationId(item.id) === normalizeStationId(focusStationId)
                );

                if (station) {
                    focusStopOnMap(
                        Number(station.latitude),
                        Number(station.longitude),
                        station.name || 'Trạm sạc'
                    );
                }
            }
        }

        function addStationToRouteById(stationId) {
            if (!latestTripContext || !Array.isArray(latestTripContext.corridorStations)) {
                return;
            }

            const normalizedId = normalizeStationId(stationId);
            const station = latestTripContext.corridorStations.find(item =>
                normalizeStationId(item.id) === normalizedId
            );

            if (!station) {
                return;
            }

            const existed = latestTripContext.selectedStops.some(item =>
                normalizeStationId(item.id) === normalizedId
            );

            if (!existed) {
                // Why changed: allow users to pin extra stations into the trip and reuse them in Google Maps.
                latestTripContext.selectedStops = [...latestTripContext.selectedStops, station];
            }

            syncRouteFromCurrentSelection(normalizedId);
        }

        function removeStationFromRouteById(stationId) {
            if (!latestTripContext) {
                return;
            }

            const normalizedId = normalizeStationId(stationId);
            latestTripContext.selectedStops = latestTripContext.selectedStops.filter(item =>
                normalizeStationId(item.id) !== normalizedId
            );

            syncRouteFromCurrentSelection();
        }

        function addStationToRouteFromButton(button) {
            if (!button) {
                return;
            }

            addStationToRouteById(button.getAttribute('data-station-id'));
        }

        function removeStationFromRouteFromButton(button) {
            if (!button) {
                return;
            }

            removeStationFromRouteById(button.getAttribute('data-station-id'));
        }

        function renderRouteStops(plan, totalDistanceKm, maxDetourKm, corridorStations) {
            const container = document.getElementById('routeStopList');
            const pagination = document.getElementById('routeStopPagination');
            const selectedStops = Array.isArray(plan?.stops) ? plan.stops : [];
            const safeCorridorStations = Array.isArray(corridorStations) ? corridorStations : [];
            const selectedIdSet = new Set(selectedStops.map(item => normalizeStationId(item.id)));

            if (!plan.isReachable && selectedStops.length === 0 && safeCorridorStations.length === 0) {
                updateRouteStopToolbarState(0, 0, true);
                updateRouteStopMeta(`Không tìm được trạm hoạt động nào nằm trong hành lang ${maxDetourKm} km của tuyến.`);
                pagination.innerHTML = '';
                container.innerHTML = `
                    <div class="route-error">
                        Đã vẽ đường đi nhưng không tìm được trạm hoạt động nào nằm trong hành lang ${maxDetourKm} km của tuyến.
                    </div>
                `;
                return;
            }

            const summaryBox = !plan.isReachable
                ? `
                    <div class="route-error">
                        Hệ thống mới đi được khoảng <strong>${plan.blockingDistanceKm.toFixed(0)} km</strong> trước khi chạm ngưỡng pin dự phòng. Bạn vẫn có thể thêm trạm thủ công vào lộ trình để mở Google Maps theo các điểm này.
                    </div>
                `
                : '';

            const selectedSection = selectedStops.length > 0
                ? `
                    <div class="route-section-head">
                        <div>
                            <div class="route-list-group-title mb-1">Các điểm đang có trong lộ trình</div>
                            <div class="route-section-subtitle">Các điểm này sẽ được đưa vào nút Google Maps theo đúng thứ tự trên hành trình.</div>
                        </div>
                        <span class="route-count-badge">${selectedStops.length} điểm dừng đã chọn</span>
                    </div>
                    <div class="route-stop-selected-list">
                        ${selectedStops.map((station, index) => buildSelectedStopHtml(station, index, totalDistanceKm)).join('')}
                    </div>
                `
                : `
                    <div class="route-empty">
                        Tuyến này chưa có điểm dừng nào trong lộ trình. Bạn có thể thêm nhanh các trạm bên dưới bằng nút <strong>Thêm vào lộ trình</strong>.
                    </div>
                `;

            const nearbyStations = safeCorridorStations.filter(station => !selectedIdSet.has(normalizeStationId(station.id)));
            const filteredNearbyStations = getFilteredNearbyStations(nearbyStations);
            const totalFiltered = filteredNearbyStations.length;
            const pageSize = Math.max(1, Number(routeListState.pageSize || 6));
            const totalPages = Math.max(1, Math.ceil(totalFiltered / pageSize));
            routeListState.page = Math.min(Math.max(1, Number(routeListState.page || 1)), totalPages);
            const startIndex = (routeListState.page - 1) * pageSize;
            const pagedNearbyStations = filteredNearbyStations.slice(startIndex, startIndex + pageSize);

            updateRouteStopToolbarState(totalFiltered, nearbyStations.length, true);
            updateRouteStopMeta(
                totalFiltered > 0
                    ? `Đang hiển thị <strong>${startIndex + 1}-${Math.min(startIndex + pagedNearbyStations.length, totalFiltered)}</strong> trên tổng <strong>${totalFiltered}</strong> trạm phù hợp. Danh sách được trình bày gọn để dễ chọn trạm cho lộ trình.`
                    : 'Không có trạm nào phù hợp với bộ lọc hiện tại. Hãy nới điều kiện lọc hoặc xóa lọc.'
            );

            const nearbySection = totalFiltered > 0
                ? `
                    <div class="route-section-head">
                        <div>
                            <div class="route-list-group-title mb-1">Trạm hoạt động gần tuyến</div>
                            <div class="route-section-subtitle">Danh sách này có lọc, sắp xếp và phân trang để quản lý dễ hơn.</div>
                        </div>
                        <span class="route-count-badge">${totalFiltered} trạm phù hợp</span>
                    </div>
                    <div class="route-station-compact-list">
                        ${pagedNearbyStations.map(station => buildNearbyStationCompactHtml(station, totalDistanceKm)).join('')}
                    </div>
                `
                : `
                    <div class="route-empty">
                        Không có trạm gần tuyến nào phù hợp với bộ lọc hiện tại.
                    </div>
                `;

            container.innerHTML = summaryBox + selectedSection + nearbySection;
            pagination.innerHTML = buildPaginationHtml(routeListState.page, totalPages);
        }

