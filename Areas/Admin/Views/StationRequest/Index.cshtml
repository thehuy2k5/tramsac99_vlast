                                       asp-action="Index"
                                       asp-route-registrationPage="1"
                                       asp-route-operationPage="@Model.OperationPage"
                                       asp-route-tab="registration">
                                        <i class="fas fa-angles-left"></i>
                                    </a>

                                    <a class="station-pagination__link @(Model.RegistrationPage <= 1 ? "is-disabled" : string.Empty)"
                                       asp-area="Admin"
                                       asp-controller="StationRequest"
                                       asp-action="Index"
                                       asp-route-registrationPage="@(Model.RegistrationPage - 1)"
                                       asp-route-operationPage="@Model.OperationPage"
