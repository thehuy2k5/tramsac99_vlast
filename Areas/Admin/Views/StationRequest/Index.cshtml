                                                        <div class="station-request-info-item">
                                                            <div class="station-request-info-item__label"><i class="fas fa-gauge-high"></i>Công suất</div>
                                                            <div class="station-request-info-item__value">@(string.IsNullOrWhiteSpace(request.PoleMaxPower) ? "-" : request.PoleMaxPower)</div>
