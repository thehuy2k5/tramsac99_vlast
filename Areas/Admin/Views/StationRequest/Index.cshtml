                                        <i class="fas fa-chevron-left"></i>
                                    </a>

                                    @for (var pageNumber = 1; pageNumber <= Model.OperationTotalPages; pageNumber++)
                                    {
                                        <a class="station-pagination__link @(pageNumber == Model.OperationPage ? "is-active" : string.Empty)"
                                           asp-area="Admin"
                                           asp-controller="StationRequest"
                                           asp-action="Index"
                                           asp-route-registrationPage="@Model.RegistrationPage"
                                           asp-route-operationPage="@pageNumber"
                                           asp-route-tab="operation">@pageNumber</a>
                                    }

                                    <a class="station-pagination__link @(Model.OperationPage >= Model.OperationTotalPages ? "is-disabled" : string.Empty)"
                                       asp-area="Admin"
                                       asp-controller="StationRequest"
                                       asp-action="Index"
                                       asp-route-registrationPage="@Model.RegistrationPage"
                                       asp-route-operationPage="@(Model.OperationPage + 1)"
                                       asp-route-tab="operation">
                                        <i class="fas fa-chevron-right"></i>
                                    </a>

                                    <a class="station-pagination__link @(Model.OperationPage >= Model.OperationTotalPages ? "is-disabled" : string.Empty)"
                                       asp-area="Admin"
                                       asp-controller="StationRequest"
                                       asp-action="Index"
                                       asp-route-registrationPage="@Model.RegistrationPage"
                                       asp-route-operationPage="@Model.OperationTotalPages"
                                       asp-route-tab="operation">
                                        <i class="fas fa-angles-right"></i>
                                    </a>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const tabButtons = Array.from(document.querySelectorAll('.station-admin-tabs__item'));
            const panels = Array.from(document.querySelectorAll('.station-admin-tab-panel'));
            const initialTargetId = '@(Model.ActiveTab == "operation" ? "station-admin-tab-operation" : "station-admin-tab-registration")';

            function activateAdminTab(targetId) {
                tabButtons.forEach(btn => {
                    btn.classList.toggle('active', btn.getAttribute('data-admin-tab-target') === targetId);
                });

                panels.forEach(panel => {
                    panel.classList.toggle('active', panel.id === targetId);
                });
            }

            tabButtons.forEach(button => {
                button.addEventListener('click', function () {
                    const targetId = this.getAttribute('data-admin-tab-target');
                    if (!targetId) return;
                    activateAdminTab(targetId);
                });
            });

            activateAdminTab(initialTargetId);
        })();
    </script>
}